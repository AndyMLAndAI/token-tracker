{
  "name": "@andymlandai/token-tracker-cli",
  "version": "1.0.0",
  "description": "Ink (React-based) CLI companion for Token Tracker - Exact local token and cost tracking",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "token-tracker": "./bin/token-tracker.js",
    "tt": "./bin/tt.js"
